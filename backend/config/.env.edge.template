# PHAROS edge worker (GPU machine). Copy to backend/.env (start_worker.ps1 and
# worker.py load it) and fill in. Placeholders only: never commit real values.
# The edge/GPU path is NOT validated in CI.

MODE=EDGE
ENV=prod

# Same database as the cloud API: jobs are durable rows there.
DATABASE_URL=postgresql://user:replace-me@your-db-host:5432/pharos?sslmode=require

# Wake-up channel shared with the cloud API (it pushes job ids to ingest_queue).
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me

# Heartbeat to the cloud API (POST /api/v1/ingestion/health/worker, admin scope).
PHAROS_CLOUD_URL=https://your-pharos-api.example.com
PHAROS_ADMIN_TOKEN=replace-me

# Embedding model served to the cloud API at /embed and /embed/batch.
EMBEDDING_MODEL_NAME=nomic-ai/nomic-embed-text-v1
# Shared secret the cloud sends as a bearer token (the cloud's EDGE_EMBED_TOKEN).
EDGE_EMBED_TOKEN=replace-me
# EDGE_EMBED_HOST=127.0.0.1
# EDGE_EMBED_PORT=8001

# Private repositories (sent only to the repository's host).
# GIT_CLONE_TOKEN=replace-me
