# PHAROS configuration. Copy to backend/config/.env (git-ignored) and edit.
# Every value below is a placeholder: never commit real tokens or passwords.
# Environment variables override this file.

# ── Runtime ────────────────────────────────────────────────────────────────
# dev | staging | prod. In prod the app refuses TEST_MODE / TESTING /
# TEST_AUTH_BYPASS and fails to start if any module fails to load.
ENV=dev
# CLOUD: API + worker without ML frameworks (embeddings come from
#        EMBEDDING_BACKEND below). EDGE: loads torch/sentence-transformers.
MODE=CLOUD

# ── Database ───────────────────────────────────────────────────────────────
# PostgreSQL 15+ with pgvector is the supported backend (HNSW + full-text
# indexes). SQLite works for tests and a quick look, without vector indexes.
# The driver is chosen automatically (psycopg2 sync / asyncpg async);
# sslmode=require in the URL is honoured by both.
DATABASE_URL=postgresql://pharos:pharos@localhost:5432/pharos
# DB_POOL_SIZE=3
# DB_MAX_OVERFLOW=7
# DB_STATEMENT_TIMEOUT=30000

# ── API authentication (machine-to-machine bearer tokens) ──────────────────
# Generate with:  python -m app.cli gen-token
# Admin: everything (indexing, deletes). Read: search, context, MCP.
# With neither set, every protected endpoint returns 401 (fails closed).
PHAROS_ADMIN_TOKEN=replace-with-output-of-gen-token
PHAROS_READ_TOKEN=replace-with-a-second-gen-token

# Browser origins allowed by CORS (only needed for a browser frontend).
# ALLOWED_ORIGINS=["http://localhost:5173"]
# Public hostnames of this server for the MCP endpoint's DNS-rebinding
# protection (localhost is always allowed), e.g. ["pharos.example.com"].
MCP_ALLOWED_HOSTS=[]

# ── Embeddings ─────────────────────────────────────────────────────────────
# hash   : offline lexical hashing (no model, NOT semantic; fine for CI/demo)
# onnx   : CPU ONNX model in EMBEDDING_ONNX_DIR (model.onnx + tokenizer.json),
#          e.g. all-MiniLM-L6-v2; pip install -r requirements-onnx.txt
# http   : the edge worker's embedding server (EDGE_EMBEDDING_URL)
# sentence-transformers : local model EMBEDDING_MODEL_NAME (EDGE mode)
# none   : keyword search only; dense/hybrid/graph report "unavailable"
# auto   : CLOUD -> http if EDGE_EMBEDDING_URL is set, else none; EDGE -> sentence-transformers
# Changing the model requires re-indexing (vectors of different models are
# never compared).
EMBEDDING_BACKEND=hash
# EMBEDDING_ONNX_DIR=/models/all-MiniLM-L6-v2/onnx
# EMBEDDING_MODEL_ID=all-MiniLM-L6-v2-onnx
# EMBEDDING_MODEL_NAME=nomic-ai/nomic-embed-text-v1
# EDGE_EMBEDDING_URL=http://edge-host:8001
# EDGE_EMBED_TOKEN=replace-with-shared-secret

# ── Ingestion jobs ─────────────────────────────────────────────────────────
# Jobs are durable rows in PostgreSQL; Redis only wakes workers up (workers
# also poll). Either a redis:// URL or Upstash REST credentials.
REDIS_URL=redis://localhost:6379/0
# UPSTASH_REDIS_REST_URL=https://example.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-me
# INGESTION_NOTIFY_KEY=ingest_queue
# Maximum jobs waiting in "queued" before submissions get HTTP 429.
MAX_QUEUE_SIZE=10
# A running job whose worker has not heartbeated for this long is re-queued.
INGESTION_JOB_STALE_SECONDS=900

# ── Repository access ──────────────────────────────────────────────────────
# Only https URLs on these hosts can be indexed through the API.
CODEINTEL_ALLOWED_GIT_HOSTS=["github.com","gitlab.com","bitbucket.org"]
CODEINTEL_MAX_FILE_BYTES=1000000
CODEINTEL_MAX_FILES=20000
CODEINTEL_CLONE_TIMEOUT_SECONDS=600
# Token for private repositories / higher rate limits (sent only to the
# repository's own host, never placed in clone URLs or logs).
# GIT_CLONE_TOKEN=replace-me
