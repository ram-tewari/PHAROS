# PHAROS cloud API image (referenced by deployment/render.yaml).
# Build context: backend/   docker build -f deployment/Dockerfile.cloud .
# Prefer backend/Dockerfile (non-root user, gunicorn) for new deployments.
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl git \
    && rm -rf /var/lib/apt/lists/*

# Hash-pinned lock (regenerate with `make lock`)
COPY requirements-cloud.txt ./
RUN pip install --no-cache-dir --require-hashes -r requirements-cloud.txt

COPY app ./app
COPY alembic ./alembic
COPY config/alembic.ini ./config/alembic.ini

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8000}/health || exit 1

# Migrations run unless RUN_MIGRATIONS=0. A database created before the
# 2026-10 migration squash needs the one-time procedure in
# docs/operations/database-migrations.md first (until then this fails with
# "Can't locate revision" and changes nothing).
CMD sh -c 'if [ "${RUN_MIGRATIONS:-1}" != "0" ]; then alembic -c config/alembic.ini upgrade head || exit 1; fi; exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}'
